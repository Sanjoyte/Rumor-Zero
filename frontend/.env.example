# =============================================================================
# Rumor Zero frontend (Next.js): environment variables
# -----------------------------------------------------------------------------
# Local dev:  Copy-Item frontend\.env.example frontend\.env.local   then edit .env.local
# Production (Cloudflare Workers):
#   - NEXT_PUBLIC_* → Workers Builds "Build variables". They are baked into the JS bundle at BUILD time.
#   - server-only   → Worker "Variables and Secrets" (runtime).
# How to get each value: docs/ENV_GUIDE.md.  NEVER commit .env.local.
# ⚠ NEXT_PUBLIC_* values are visible to every visitor. Never put a secret in one.
# Tags: [LOCAL: required|optional]  [PROD: required|optional]
# =============================================================================

# ---------- Server-only (API relay + server components) ------------------------
# Where the API relay (src/app/api/[...path]/route.ts) and server-side rendering reach Django.
# [LOCAL: required] [PROD: required, e.g. https://rumor-zero-api.onrender.com (runtime variable)]
BACKEND_ORIGIN=http://localhost:8000

# Sent to Django as X-RZ-Proxy-Secret. MUST equal PROXY_SHARED_SECRET in backend env.
# [LOCAL: required] [PROD: required, stored as a Worker *Secret*]
PROXY_SHARED_SECRET=local-dev-only-relay-secret

# ---------- Public (inlined into browser code at build time) --------------------
# Canonical site origin, used for absolute links and Open Graph tags.
# [LOCAL: required] [PROD: required, e.g. https://rumor-zero.<account>.workers.dev]
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turnstile site key. The default is Cloudflare's official "always passes" TEST key.
# [LOCAL: required, keep the test value] [PROD: required, your widget's real site key]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google OAuth Web Client ID (same value as backend GOOGLE_OAUTH_CLIENT_ID). Client IDs are public by design.
# Empty = the "Continue with Google" button is hidden.
# [LOCAL: optional until Part 3] [PROD: required]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
