# =============================================================================
# Rumor Zero backend (Django): environment variables
# -----------------------------------------------------------------------------
# Local dev:  cp backend/.env.example backend/.env   (Windows: Copy-Item backend\.env.example backend\.env)
#             then edit backend/.env
# Production: set these in Render → service → Environment (never in a file).
# How to get or generate each value: docs/ENV_GUIDE.md (same order as here).
# Format: KEY=value, no spaces around "=". Quote values that contain spaces.
# NEVER commit backend/.env. Only this .example file is tracked by git.
# Tags: [LOCAL: required|optional]  [PROD: required|optional]
# =============================================================================

# ---------- Core Django ------------------------------------------------------
# Secret used by Django for signing (sessions, password-reset keys, etc.).
# [LOCAL: required] [PROD: required, a different long random value] (ENV_GUIDE 1.2)
DJANGO_SECRET_KEY=local-dev-only-replace-me-with-a-generated-value

# Debug pages and verbose errors. True ONLY on your machine.
# [LOCAL: required] [PROD: required, must be False]
DJANGO_DEBUG=True

# Comma-separated hostnames this server answers to.
# [LOCAL: required] [PROD: required, e.g. rumor-zero-api.onrender.com]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (scheme://host[:port]) allowed to submit Django Admin forms.
# [LOCAL: required] [PROD: required, e.g. https://rumor-zero-api.onrender.com]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# URL path of Django Admin (the moderation panel). Must end with "/".
# [LOCAL: optional, default admin/] [PROD: required, an unguessable path]
ADMIN_URL_PATH=admin/

# ---------- Database ---------------------------------------------------------
# PostgreSQL connection URL. Local value matches compose.yaml (Part 0A).
# [LOCAL: required] [PROD: required, the Neon *direct* (non-pooled) URL with ?sslmode=require]
DATABASE_URL=postgres://rumor_zero:rumor_zero@localhost:5432/rumor_zero

# ---------- Cache / throttling ------------------------------------------------
# Redis URL for the feed cache and rate-limit counters.
# Empty = in-process memory cache, fine for a single dev server.
# [LOCAL: optional] [PROD: required, the Upstash rediss:// URL]
REDIS_URL=redis://localhost:6379/0

# ---------- Frontend and API relay ---------------------------------------------
# Public origin of the Next.js site (scheme://host[:port], no path). Used in email links and the
# Origin check on every /api/auth/ request. Must be https when DJANGO_DEBUG is False.
# [LOCAL: required, and open the site as http://localhost:3000, not 127.0.0.1]
# [PROD: required, e.g. https://rumor-zero.<account>.workers.dev]
FRONTEND_ORIGIN=http://localhost:3000

# Shared secret the frontend API relay sends in X-RZ-Proxy-Secret, so the real
# client IP header can be trusted. MUST equal PROXY_SHARED_SECRET in frontend env.
# [LOCAL: required] [PROD: required, a new long random value]
PROXY_SHARED_SECRET=local-dev-only-relay-secret

# Mark the refresh-token cookie "Secure" (HTTPS only). False only for http://localhost.
# Django refuses to start with False when DJANGO_DEBUG is False.
# [LOCAL: required, False] [PROD: required, True]
AUTH_COOKIE_SECURE=False

# ---------- Auth tokens (django-allauth headless, JWT strategy) --------------
# HS256 signing key for access/refresh JWTs: at least 32 characters, different from
# DJANGO_SECRET_KEY (Django refuses to start otherwise, naming the variable).
# [LOCAL: required] [PROD: required, a new long random value]
JWT_SIGNING_KEY=local-dev-only-jwt-signing-key-change-me

# Access-token lifetime in minutes (kept in browser memory). Guide 4.6: ~15.
# [LOCAL: optional] [PROD: optional]
JWT_ACCESS_TOKEN_MINUTES=15

# Refresh-token lifetime in days (httpOnly cookie). Guide 4.6: 7–14.
# [LOCAL: optional] [PROD: optional]
JWT_REFRESH_TOKEN_DAYS=14

# ---------- Cloudflare Turnstile (bot check on signup) -----------------------
# Server-side secret. The default below is Cloudflare's official "always passes" TEST secret.
# [LOCAL: required, keep the test value] [PROD: required, the real secret from your widget]
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------- Google sign-in -----------------------------------------------------
# OAuth Web Client ID. The backend checks that Google ID tokens were issued for it.
# No client secret is needed for this flow, so don't store one.
# Empty = "Continue with Google" is disabled.
# Must be the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.local.
# [LOCAL: optional, empty hides Google sign-in] [PROD: required]
GOOGLE_OAUTH_CLIENT_ID=

# ---------- Email --------------------------------------------------------------
# Which email backend to use: console = print emails in the runserver terminal;
# file = write them to backend/tmp/mail/ (git-ignored; for E2E tests);
# brevo = send through the Brevo HTTPS API (Render blocks SMTP).
# Django refuses to start with anything but brevo when DJANGO_DEBUG is False.
# [LOCAL: required, console] [PROD: required, brevo]
EMAIL_PROVIDER=console

# "From" header for verification and reset emails. In prod, use your Brevo-verified sender address.
# [LOCAL: optional] [PROD: required]
DEFAULT_FROM_EMAIL="Rumor Zero <no-reply@example.com>"

# Brevo API key (starts with "xkeysib-").
# [LOCAL: not used] [PROD: required when EMAIL_PROVIDER=brevo]
BREVO_API_KEY=

# ---------- Platform thresholds (initial defaults) ----------------------------
# Seeded into the PlatformSettings row. Senior moderators can change them later in Django Admin.
# Reports needed (within the window) to send a post to human review. Guide 6.2.
# [LOCAL: optional] [PROD: optional]
REPORT_THRESHOLD=5
# Length of that window, in hours.
REPORT_WINDOW_HOURS=24
# Reports from accounts younger than this (and with no posts/comments) don't count. Guide 6.3.
REPORT_MIN_ACCOUNT_AGE_HOURS=24
# Minimum pipeline confidence (0–100) to auto-label a fact post. Guide 7.2: 80–85.
CONFIDENCE_THRESHOLD=85
# Max fact posts per user per rolling 24 hours (Stitch composer quota; deleted and removed ones
# still count; 0 pauses fact posts). ANALYSIS D7.
FACT_POSTS_PER_DAY=10
# Seconds the first page of a user's Following feed stays cached (guide 9.2: 20–60; 0 turns the
# cache off; max 300). Read by Django settings, not seeded into PlatformSettings.
FEED_CACHE_SECONDS=30

# ---------- Emergency posts (initial defaults; ANALYSIS f-1, ARCHITECTURE 4b) ------
# Seeded into the PlatformSettings row like the thresholds above. Senior moderators can change
# them later in Django Admin. All optional: if a line is missing, the default shown here applies.
# How long an emergency fact post stays pinned at the top of feeds, in hours.
# [LOCAL: optional] [PROD: optional]
EMERGENCY_DURATION_HOURS=24
# Emergency posts allowed per user per rolling 24 hours (they also count toward FACT_POSTS_PER_DAY).
EMERGENCY_POSTS_PER_DAY=1
# Minimum account age, in days, before a user may post an emergency.
EMERGENCY_MIN_ACCOUNT_AGE_DAYS=7
# Minimum credibility score (0–100; every account starts at 50) needed to post an emergency.
EMERGENCY_MIN_REPUTATION=40
# Counting reports (within REPORT_WINDOW_HOURS) that send an ACTIVE emergency post to human review.
EMERGENCY_REPORT_THRESHOLD=2
# Days a user can't post emergencies after one of their emergency posts ends FALSE.
EMERGENCY_FALSE_COOLDOWN_DAYS=30

# ---------- Fact-check pipeline -------------------------------------------------
# stub = built-in rule-based fake (MVP); http = future real pipeline at PIPELINE_URL.
# [LOCAL: required, stub] [PROD: required, stub until the real pipeline exists]
PIPELINE_BACKEND=stub
# Right after a fact post is saved, process it in a background thread (fast path).
# Tests set this to False. [LOCAL: optional] [PROD: optional, True]
PIPELINE_INLINE_KICK=True
# Future real pipeline endpoint and key. Leave empty in the MVP.
# [LOCAL: not used] [PROD: not used yet]
PIPELINE_URL=
PIPELINE_API_KEY=

# ---------- Internal scheduled jobs ------------------------------------------
# Secret header (X-RZ-Cron-Secret) required by /api/internal/tick/ and /api/health/deep/.
# [LOCAL: required] [PROD: required, a new long random value]
INTERNAL_CRON_SECRET=local-dev-only-cron-secret

# ---------- Monitoring (Sentry) ----------------------------------------------
# Empty = Sentry disabled. [LOCAL: leave empty] [PROD: optional but recommended]
SENTRY_DSN=
# Environment tag shown in Sentry. [PROD: production]
SENTRY_ENVIRONMENT=local
# Fraction of requests traced for performance (0.0–1.0). 0.0 keeps well inside the free quota.
SENTRY_TRACES_SAMPLE_RATE=0.0
